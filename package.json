{
  "name": "atomic-brain-corp",
  "version": "1.0.0",
  "description": "Atomic Corporate Brain",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:electron": "electron-builder"
  },
  "build": {
    "appId": "com.atomic.brain",
    "productName": "Atomic Brain",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "portable": {
      "artifactName": "Atomic Brain.exe"
    }
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^173.0.0",
    "multer": "^2.1.1",
    "node-telegram-bot-api": "^0.67.0",
    "openai": "^6.42.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1"
  }
}
